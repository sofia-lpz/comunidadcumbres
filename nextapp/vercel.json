{
  "functions": {
    "src/app/api/**": {
      "maxDuration": 10
    }
  },
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    }
  ]
}
