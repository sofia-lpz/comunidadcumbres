# Variables de entorno para Vercel deployment
# Configura estas variables en tu dashboard de Vercel

# FRONTEND (cliente) - Variables públicas
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# BACKEND (API routes) - Variables privadas
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
# O si no tienes service role key, usa la anon key también para el backend:
SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# INSTRUCCIONES PARA VERCEL:
# 1. Ve a tu proyecto en Vercel Dashboard
# 2. Settings > Environment Variables
# 3. Agrega todas las variables de arriba
# 4. Para obtener las claves:
#    - Ve a tu proyecto en supabase.com
#    - Settings > API
#    - Project URL = SUPABASE_URL y NEXT_PUBLIC_SUPABASE_URL
#    - anon public key = SUPABASE_ANON_KEY y NEXT_PUBLIC_SUPABASE_ANON_KEY
#    - service_role key = SUPABASE_SERVICE_ROLE_KEY (opcional, más seguro)
# 5. Redeploy tu aplicación
