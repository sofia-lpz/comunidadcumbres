# Variables de entorno para desarrollo local
# Copia este archivo a .env.local y completa con tus credenciales reales

# Supabase Configuration (necesario para desarrollo)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Variables privadas (solo para servidor, opcional en desarrollo)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Node Environment
NODE_ENV=development

# Instrucciones:
# 1. Ve a tu proyecto en supabase.com
# 2. Ve a Settings > API
# 3. Copia tu Project URL como NEXT_PUBLIC_SUPABASE_URL
# 4. Copia tu anon public key como NEXT_PUBLIC_SUPABASE_ANON_KEY
# 5. Para Vercel, configura estas variables en tu dashboard de Vercel
